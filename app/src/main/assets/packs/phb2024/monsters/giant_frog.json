    "actions":  [
                    {
                        "name":  {
                                     "en":  "",
                                     "ru":  "Укус"
                                 },
                        "description":  {
                                            "en":  "",
                                            "ru":  "Бросок рукопашной атаки: +3, досягаемость 5 фт. Попадание: 5 (1к6 + 2) Колющего урона. Если цель Среднего размера или меньше, она получает состояние Схваченный (Сл освобождения от захвата 11)."
                                        }
