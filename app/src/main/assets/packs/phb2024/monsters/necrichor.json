    "actions":  [
                    {
                        "name":  {
                                     "en":  "",
                                     "ru":  "Мультиатака"
                                 },
                        "description":  {
                                            "en":  "",
                                            "ru":  "Некрихор совершает две атаки Некротическим выбросом."
                                        }
