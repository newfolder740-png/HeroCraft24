{"key_attributes":{"Основная характеристика":"Мудрость","Тренированность с доспехами":"Лёгкие и Средние доспехи и Щиты","Владение навыками":"Выберите два: История, Медицина, Проницательность, Религия или Убеждение","Хиты за уровень":"1к8 (или 5) + ваш модификатор Телосложения (суммарно минимум 1)","Кость хитов":"К8 за уровень Жреца","Владение спасбросками":"Мудрость и Харизма","Владение оружием":"Простое оружие","Начальное снаряжение":"Выберите А или Б:"},"starting_equipment":[{"description":{"en":"Choose A or B","ru":"Выберите А или Б:"},"options":[{"options":[{"quantity":1,"item_id":"phb2024:chain_shirt"},{"quantity":1,"item_id":"phb2024:shield"},{"quantity":1,"item_id":"phb2024:mace"},{"quantity":1,"item_id":"phb2024:holy_symbol"},{"quantity":1,"item_id":"phb2024:priest_s_pack"},{"quantity":1,"description":{"en":"7 gp","ru":"7 ЗМ"}}],"description":{"en":"A","ru":"А"}},{"options":[{"quantity":1,"description":{"en":"110 gp","ru":"110 ЗМ"}}],"description":{"en":"B","ru":"Б"}}],"count":1}],"id":"cleric","type":"class","source":{"book":{"en":"Player\u0027s Handbook (2024)","ru":"Книга игрока (2024)"},"abbreviation":"PHB2024"},"name":{"en":"Cleric","ru":"Жрец"},"spellcasting":{"type":"prepared","ability":"wisdom"},"acquisition":{"first_class":{"en":"","ru":"Получите все атрибуты из таблицы «Ключевые атрибуты Жреца». Получите умения Жреца 1-го уровня; они перечислены в таблице «Умения Жреца»."},"multiclass":{"en":"","ru":"Получите следующие атрибуты из таблицы «Ключевые атрибуты Жреца»: Кость хитов и тренированность с Лёгкими и Средними доспехами и Щитами. Получите умения Жреца 1-го уровня; они перечислены в таблице «Умения Жреца»."}},"hit_die":8,"starting_proficiencies":{"armor":["light","medium","shields"],"tools":[],"weapons":["simple"],"skills":[],"saving_throws":["wisdom","charisma"]},"short_description":{"en":"","ru":""},"saving_throws":["wisdom","charisma"],"skills":{"count":2,"from":["history","medicine","insight","religion","persuasion"]},"subclass_level":3,"ta