  "acquisition": {
    "first_class": {
      "en": "",
      "ru": "Получите все атрибуты из таблицы «Ключевые атрибуты Жреца». Получите умения Жреца 1-го уровня; они перечислены в таблице «Умения Жреца»."
    },
    "multiclass": {
      "en": "",
      "ru": "Получите следующие атрибуты из таблицы «Ключевые атрибуты Жреца»: Кость хитов и тренированность с Лёгкими и Средними доспехами и Щитами. Получите умения Жреца 1-го уровня; они перечислены в таблице «Умения Жреца»."
    }
  },
