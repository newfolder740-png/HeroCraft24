  "acquisition": {
    "first_class": {
      "en": "",
      "ru": "Получите все атрибуты из таблицы «Ключевые атрибуты Барда». Получите умения Барда 1-го уровня; они перечислены в таблице «Умения Барда»."
    },
    "multiclass": {
      "en": "",
      "ru": "Получите следующие атрибуты из таблицы «Ключевые атрибуты Барда»: Кость Хитов, владение одним навыком на ваш выбор, владение одним Музыкальным инструментом на ваш выбор и тренированность с Лёгкими доспехами. Получите умения Барда 1-го уровня."
    }
  },
