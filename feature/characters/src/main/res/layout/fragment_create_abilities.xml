<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Name input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/name_input_layout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Имя">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/name_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Ability score slots (drop targets) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Характеристики"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <GridLayout
            android:id="@+id/slots_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:columnCount="3"
            android:rowCount="2">

            <!-- Row 1: STR, DEX, CON -->
            <FrameLayout
                android:id="@+id/slot_strength"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:background="@drawable/bg_ability_slot">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/slot_strength_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="—"
                        android:textAppearance="?attr/textAppearanceHeadlineSmall" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Сила"
                        android:textAppearance="?attr/textAppearanceBodySmall" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/slot_dexterity"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:background="@drawable/bg_ability_slot">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/slot_dexterity_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="—"
                        android:textAppearance="?attr/textAppearanceHeadlineSmall" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Ловкость"
                        android:textAppearance="?attr/textAppearanceBodySmall" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/slot_constitution"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:background="@drawable/bg_ability_slot">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/slot_constitution_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="—"
                        android:textAppearance="?attr/textAppearanceHeadlineSmall" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Телосложение"
                        android:textAppearance="?attr/textAppearanceBodySmall" />
                </LinearLayout>
            </FrameLayout>

            <!-- Row 2: INT, WIS, CHA -->
            <FrameLayout
                android:id="@+id/slot_intelligence"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:background="@drawable/bg_ability_slot">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/slot_intelligence_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="—"
                        android:textAppearance="?attr/textAppearanceHeadlineSmall" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Интеллект"
                        android:textAppearance="?attr/textAppearanceBodySmall" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/slot_wisdom"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:background="@drawable/bg_ability_slot">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/slot_wisdom_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="—"
                        android:textAppearance="?attr/textAppearanceHeadlineSmall" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Мудрость"
                        android:textAppearance="?attr/textAppearanceBodySmall" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/slot_charisma"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:background="@drawable/bg_ability_slot">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/slot_charisma_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="—"
                        android:textAppearance="?attr/textAppearanceHeadlineSmall" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="Харизма"
                        android:textAppearance="?attr/textAppearanceBodySmall" />
                </LinearLayout>
            </FrameLayout>

        </GridLayout>

        <!-- Ability score controls (drag sources) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Значения"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <GridLayout
            android:id="@+id/controls_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingBottom="8dp"
            android:columnCount="3"
            android:rowCount="2">

            <!-- Row 1: STR, DEX, CON controls -->
            <LinearLayout
                android:id="@+id/control_strength"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_strength_minus"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:text="−" />

                <TextView
                    android:id="@+id/value_strength"
                    android:layout_width="36dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="8"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_strength_plus"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:text="+" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/control_dexterity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_dexterity_minus"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:text="−" />

                <TextView
                    android:id="@+id/value_dexterity"
                    android:layout_width="36dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="8"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_dexterity_plus"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:text="+" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/control_constitution"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_constitution_minus"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:text="−" />

                <TextView
                    android:id="@+id/value_constitution"
                    android:layout_width="36dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="8"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_constitution_plus"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:text="+" />
            </LinearLayout>

            <!-- Row 2: INT, WIS, CHA controls -->
            <LinearLayout
                android:id="@+id/control_intelligence"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_intelligence_minus"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:text="−" />

                <TextView
                    android:id="@+id/value_intelligence"
                    android:layout_width="36dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="8"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_intelligence_plus"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:text="+" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/control_wisdom"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_wisdom_minus"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:text="−" />

                <TextView
                    android:id="@+id/value_wisdom"
                    android:layout_width="36dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="8"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_wisdom_plus"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:text="+" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/control_charisma"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_charisma_minus"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:text="−" />

                <TextView
                    android:id="@+id/value_charisma"
                    android:layout_width="36dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="8"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_charisma_plus"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:text="+" />
            </LinearLayout>

        </GridLayout>

        <!-- Mode toggle buttons -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/mode_toggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mode_custom"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Кастом" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mode_4d6"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="4d6" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mode_buy"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Buy" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Reroll button (visible only in 4d6 mode) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_reroll"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Переброс"
            android:visibility="gone" />

        <!-- Reset button (visible only in custom/buy modes) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_reset"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Сброс"
            android:visibility="gone" />

        <!-- Points counter (visible only in Buy mode) -->
        <TextView
            android:id="@+id/points_counter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:text="0/27"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
